# Ruta absoluta al vault de Obsidian
VAULT_PATH=/Users/pablorio/Library/CloudStorage/GoogleDrive-priopelliza@gmail.com/Mi unidad/PachiMind/PachiMind

# API Keys: formato JSON  {"clave": "scope"}
# Scopes disponibles: personal | ai_context | public
API_KEYS={"mi-clave-personal-secreta": "personal", "clave-para-ia": "ai_context"}

# Log level
LOG_LEVEL=INFO

# CORS — en producción reemplazar * por el dominio real
CORS_ORIGINS=["*"]
