# ── PachiMind — Variables de producción ─────────────────────────────────
# Copiar como /srv/pachimind/.env en el servidor
# NUNCA commitear este archivo con valores reales

# Vault
VAULT_PATH=/srv/pachimind/vault

# API Keys — genera una clave fuerte: openssl rand -hex 32
# El scope "personal" da acceso completo de lectura/escritura
API_KEYS={"pm-prod-REPLACE_WITH_STRONG_KEY": "personal"}

# Logging
LOG_LEVEL=INFO

# CORS — solo el dominio propio en producción
CORS_ORIGINS=["https://pachimind.rail.ar"]

# Gemini API (para el servidor Node.js)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Node.js
NODE_ENV=production
PORT=3000

# NotebookLM CLI — sesión propia del servidor (ver deploy/README.md,
# sección "Reuniones (NotebookLM)"). Copiar storage_state.json + context.json
# desde ~/.notebooklm/profiles/default/ de tu Mac a NOTEBOOKLM_HOME en el
# servidor — no generar credenciales nuevas acá.
NOTEBOOKLM_HOME=/srv/pachimind/.notebooklm
NOTEBOOKLM_BIN=/srv/pachimind/api/.venv/bin/notebooklm

# SMTP para el digest semanal (weekly_digest.py) — reusa tu proveedor existente
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_SMTP_USER
DIGEST_TO=YOUR_EMAIL
PACHIMIND_API_URL=http://127.0.0.1:8000
PACHIMIND_API_KEY=YOUR_PROD_API_KEY
